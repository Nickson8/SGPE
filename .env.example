# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_USER=sgpe
POSTGRES_PASSWORD=sgpe
POSTGRES_DB=sgpe_db

# ── Backend (FastAPI) ───────────────────────────────────────────────────
# Driver async (asyncpg). O host "postgres" é o nome do serviço no compose.
DATABASE_URL=postgresql+asyncpg://sgpe:sgpe@postgres:5432/sgpe_db
FRONTEND_ORIGIN=http://localhost:5173

# ── Frontend (Vite/React) ───────────────────────────────────────────────
# URL acessada pelo NAVEGADOR (não pela rede interna do Docker).
VITE_API_URL=http://localhost:8000/api
